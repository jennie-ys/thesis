{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thesis",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GITHUB_OWNER": "jennie-ys",
    "GITHUB_REPO": "thesis"
  },
  "main": "dist/_worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "workers_dev": true
}
